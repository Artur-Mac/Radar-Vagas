# Data Career Radar - Environment Variables Configuration Example
# Copy this file to .env for local environment overrides.

# Execution environment: development | testing | production
ENVIRONMENT=development

# Logging output verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Local DuckDB / SQLite database path
DB_PATH=data/radar_vagas.db

# Local Ollama HTTP service URL
OLLAMA_BASE_URL=http://localhost:11434

# Configured Ollama model name (e.g. gemma4:26b or llama3.2)
# Note: Ensure the model is downloaded via 'ollama pull <model_name>'
OLLAMA_MODEL=gemma4:26b
